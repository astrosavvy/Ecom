{
  "name": "younoya-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix younoya-web run dev",
    "build": "npm --prefix younoya-web run build && node scripts/sync-dist.mjs",
    "preview": "npm --prefix younoya-web run preview",
    "serve": "node serve.js",
    "deploy": "npm --prefix younoya-web run deploy",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build"
  }
}
