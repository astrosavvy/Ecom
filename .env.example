# Database (Neon PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evershop
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Application
SHOP_PORT=3000
SHOP_BASE_URL=http://localhost:3000
COOKIE_SECRET=change_this_to_a_random_secure_secret_in_production

# Static assets CDN (Cloudflare Pages)
ASSET_BASE_URL=

# Cloudflare Tunnel Token (Zero-Trust Edge Connectivity)
TUNNEL_TOKEN=eyJhSWoiOiI...your_cloudflare_tunnel_token_here...

# Self-Hosted MinIO Object Storage (S3-Compatible)
MINIO_ROOT_USER=admin_younoya
MINIO_ROOT_PASSWORD=change_this_minio_password_in_production
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=younoya-media
S3_ACCESS_KEY_ID=admin_younoya
S3_SECRET_ACCESS_KEY=change_this_minio_password_in_production

# Cloudflare R2 (Alternative Managed Cloud S3 Object Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# OTP (extension)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_MAX_PER_HOUR=10

# Email / SMTP (SendPulse)
SMTP_HOST=smtp-pulse.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@younoya.com
SMTP_FROM_NAME=YOUNOYA

# Support
SUPPORT_EMAIL=support@younoya.com
